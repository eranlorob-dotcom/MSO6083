  border-bottom:1px solid var(--line);z-index:1200}
.brand{display:flex;align-items:center;gap:13px;min-width:0}
.mark{width:40px;height:40px;border-radius:11px;flex:0 0 auto;display:grid;place-items:center;
  background:radial-gradient(circle at 32% 28%,var(--teal),var(--navy) 75%);
