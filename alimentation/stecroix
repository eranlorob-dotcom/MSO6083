.mark svg{width:22px;height:22px}
.title h1{font-size:1.12rem;font-weight:700;line-height:1.12}
.title h1 span{color:var(--teal)}
.title p{font-size:.78rem;color:var(--ink2);font-weight:400;margin-top:2px}
.spacer{flex:1 1 auto}
.tools{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
