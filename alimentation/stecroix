function rampColor(v,min,max,stops){stops=stops||RAMP;if(v==null)return null;var t=Math.max(0,Math.min(1,(v-min)/(max-min)));var s=t*(stops.length-1),i=Math.min(Math.floor(s),stops.length-2);return lerp(stops[i],stops[i+1],s-i);}
function fmt(n,d){return n==null?'—':Number(n).toLocaleString('fr-CA',{minimumFractionDigits:d||0,maximumFractionDigits:d||0});}

var VMIN=0, VMAX=8000; // ajuste apres recalcul

/* ===== Carte ===== */
var map=L.map('map',{zoomControl:true});
L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png',{
  attribution:'© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> · <a href="https://carto.com/">CARTO</a> · CISSS des Laurentides',
  maxZoom:19, subdomains:'abcd'}).addTo(map);

var selected=null;
function clearSelection(){if(selected&&selected.layer&&selected.resetStyle)selected.resetStyle(selected.layer);selected=null;}

/* ===== Couches de reference : limite municipale + PU ===== */
var boundaryLayer=L.geoJSON(DATA_BOUNDARY,{
  style:{fill:false,color:'#c4c8ea',weight:1.8,dashArray:'6 5',opacity:.85,interactive:false}
}).addTo(map);
var puLayer=L.geoJSON(DATA_PU,{
  style:{fillColor:'#21AEAD',fillOpacity:.06,color:'#21AEAD',weight:2,opacity:.9,interactive:false}
}).addTo(map);

/* ===== Resultats calcules en direct, par AD (index = ordre de DATA_DA.features) ===== */
var LIVE=[]; // {n, distMean, overThreshold, isDesertLive, statusLabel, rfeiMean, isSwamp}

function daStyle(f,idx){
  var p=f.properties;
  var l=LIVE[idx];
  if(p.n_buildings===0){
    return {fillColor:'#8b8fc4',fillOpacity:.10,weight:1,color:'#8b8fc4',opacity:.5,dashArray:'4 3'};
  }
  var v=l?l.distMean:null, c=rampColor(v,VMIN,VMAX);
  var isDesert=l&&l.isDesertLive===true;
  return {fillColor:c||'#8b8fc4',fillOpacity:v==null?.15:.72,
    weight:isDesert?3:1, color:isDesert?'#ffffff':'#ffffff55', opacity:isDesert?1:.7};
}
function daTooltipHTML(f,idx){
  var p=f.properties, l=LIVE[idx];
  if(p.n_buildings===0){
    return '<div class="tt-nom">AD '+p.ad+'</div><div class="tt-mrc">Quintile matériel : '+(p.quintmat||'—')+'</div>'+
      '<div class="tt-mrc" style="margin-top:3px;font-style:italic">Aucun bâtiment de Sainte-Croix — non calculable</div>';
  }
  var v=l?l.distMean:null, c=rampColor(v,VMIN,VMAX);
  var statut = l ? l.statusLabel : 'Recalcul en cours…';
  var html='<div class="tt-nom">AD '+p.ad+'</div><div class="tt-mrc">'+(p.milieu||'—')+' · '+p.n_buildings+' bâtiment(s) · '+fmt(p.pop2021)+' hab. (2021)</div>';
  html+='<div class="tt-val" style="color:'+c+'">'+fmt(v)+' m</div>';
  html+='<div class="tt-mrc" style="margin-top:3px">'+statut+'</div>';
  if(l) html+='<div class="tt-mrc">RFEI moy. '+(l.rfeiMean==null?'—':fmt(l.rfeiMean,1))+(l.isSwamp?' — marécage':'')+'</div>';
  return html;
}
var daLayer=L.geoJSON(DATA_DA,{
  style:function(f){ return daStyle(f, DATA_DA.features.indexOf(f)); },
  onEachFeature:function(f,layer){
    var idx=DATA_DA.features.indexOf(f);
    layer.bindTooltip(daTooltipHTML(f,idx),{className:'muni-tooltip',sticky:true,direction:'top',offset:[0,-6]});
    layer.on({
      mouseover:function(){if(selected&&selected.layer===layer)return;layer.setStyle({weight:2.5,color:'#fff',opacity:1,dashArray:null});},
      mouseout:function(){if(selected&&selected.layer===layer)return;daLayer.resetStyle(layer);},
      click:function(){selectDA(f,idx,layer);}
    });
  }
}).addTo(map);

function refreshDA(layer,f,idx){
  layer.setTooltipContent(daTooltipHTML(f,idx));
  daLayer.resetStyle(layer);
}

function selectDA(f,idx,layer){
  clearSelection();
  selected={layer:layer,resetStyle:function(l){daLayer.resetStyle(l);}};
  layer.setStyle({weight:3,color:'#fff',opacity:1,fillOpacity:.88,dashArray:null});
  var p=f.properties, l=LIVE[idx];

  if(p.n_buildings===0){
    var html0 = '<div class="eyebrow">Aire de diffusion (2021)</div>'+
      '<div class="scopename">AD '+p.ad+'</div>'+
      '<div class="scopesub"><span>Sainte-Croix, Lotbinière</span></div>'+
      '<div class="warn">Cette AD déborde de Sainte-Croix et ne contient aucun bâtiment résidentiel recensé sur le territoire municipal. Le désert et le marécage alimentaires ne peuvent pas être calculés à partir des données fournies (l\'essentiel de sa population réside dans une municipalité voisine).</div>'+
      '<div class="statgrid">'+
      '<div class="statline"><span class="k">Population totale de l\'AD (2021)</span><span class="v">'+fmt(p.pop2021)+'</span></div>'+
      '<div class="statline"><span class="k">Quintile matériel (défavorisation)</span><span class="v">'+(p.quintmat||'—')+(p.quintmat===5?' (Q5)':'')+'</span></div>'+
      '</div>';
    document.getElementById('empty').style.display='none';
    var pr0=document.getElementById('profil'); pr0.style.display='block'; pr0.innerHTML=html0;
    return;
  }

  var v=l?l.distMean:null, c=rampColor(v,VMIN,VMAX);
  var isDesert=l&&l.isDesertLive===true;
  var seuil = p.milieu==='Urbain' ? '1000 m' : '16 000 m';
  var lowN = p.n_buildings<5;
  var badges='';
  if(isDesert) badges+='<div class="pillstat" style="background:#ffffff22;color:#fff;border:1px solid #ffffff55">&#11044; Désert alimentaire confirmé</div>';
  else badges+='<div class="pillstat" style="background:#21aead1f;color:var(--teal);border:1px solid #21aead40">Non désert</div>';
  if(l&&l.isSwamp) badges+='<div class="pillstat" style="background:#5b54c02a;color:#a9a4e8;border:1px solid #5b54c055">&#11044; Marécage alimentaire (RFEI ≥ 5,0)</div>';
  var html = '<div class="eyebrow">Aire de diffusion (2021)</div>'+
    '<div class="scopename">AD '+p.ad+'</div>'+
    '<div class="scopesub"><span>Sainte-Croix, Lotbinière</span><span class="badge">'+p.milieu+'</span></div>'+
    '<div class="hero"><div class="lab">Distance moyenne au commerce sain (bâtiments résidentiels, OSM)</div>'+
    '<div class="big mono" style="color:'+c+'">'+fmt(v)+'<small>m</small></div>'+
    '<div class="sub">Seuil applicable en milieu '+p.milieu.toLowerCase()+' : '+seuil+'</div></div>'+
    badges+
    '<div class="statgrid">'+
    '<div class="statline"><span class="k">Population de l\'AD (2021)</span><span class="v">'+fmt(p.pop2021)+'</span></div>'+
    '<div class="statline"><span class="k">Milieu (majorité des bâtiments)</span><span class="v">'+p.milieu+'</span></div>'+
    '<div class="statline"><span class="k">Quintile matériel</span><span class="v">'+p.quintmat+(p.quintmat===5?' (Q5)':'')+'</span></div>'+
    '<div class="statline"><span class="k">Bâtiments résidentiels (Sainte-Croix)</span><span class="v">'+p.n_buildings+'</span></div>'+
    '<div class="statline"><span class="k">RFEI moyen</span><span class="v">'+(l&&l.rfeiMean!=null?fmt(l.rfeiMean,2):'—')+'</span></div>'+
    '</div>'+
    (lowN?'<div class="warn">Seulement '+p.n_buildings+' bâtiment(s) résidentiel(s) dans cette AD sur le territoire — estimation peu fiable statistiquement.</div>':'')+
    '<div class="note">Distance et RFEI calculés en direct par bâtiment résidentiel puis moyennés — voir &#9432; Méthodologie.</div>';
  document.getElementById('empty').style.display='none';
  var pr=document.getElementById('profil'); pr.style.display='block'; pr.innerHTML=html;
}

function selectGeneric(title,eyebrow,badge,html){
  clearSelection();
  document.getElementById('empty').style.display='none';
  var pr=document.getElementById('profil'); pr.style.display='block';
  pr.innerHTML='<div class="eyebrow">'+eyebrow+'</div><div class="scopename">'+title+'</div>'+
    (badge?'<div class="scopesub"><span class="badge">'+badge+'</span></div>':'')+html;
}

map.fitBounds(boundaryLayer.getBounds(),{paddingTopLeft:[430,40],paddingBottomRight:[40,40]});

/* ===== Filtres ===== */
function applyFilters(){
  var m=document.getElementById('filter-milieu').value, s=document.getElementById('filter-statut').value;
  daLayer.eachLayer(function(l2){
    var idx=DATA_DA.features.indexOf(l2.feature);
    var p=l2.feature.properties, live=LIVE[idx];
    var okM=(!m||p.milieu===m);
    var okS=true;
    if(s==='desert') okS=!!(live&&live.isDesertLive===true);
    else if(s==='swamp') okS=!!(live&&live.isSwamp);
    else if(s==='neither') okS=!!(live&&live.isDesertLive!==true&&!live.isSwamp);
    var show=okM&&okS;
    l2.setStyle({opacity:show?.9:.06,fillOpacity:show?(p.n_buildings===0?.1:.72):.03});
  });
}
document.getElementById('filter-milieu').onchange=applyFilters;
document.getElementById('filter-statut').onchange=applyFilters;

/* ===== Legende sequentielle ===== */
function buildLegendScale(){
  document.getElementById('legend-scale').innerHTML=RAMP.map(function(c){return'<div style="background:'+c+'"></div>';}).join('');
  document.getElementById('lg-min').textContent=fmt(VMIN);
  document.getElementById('lg-mid').textContent=fmt((VMIN+VMAX)/2);
  document.getElementById('lg-max').textContent=fmt(VMAX)+'+';
}
buildLegendScale();

/* =========================================================================
   COUCHE OSM (Overpass) — commerces alimentaires. Sert a recalculer EN DIRECT,
   pour chaque BATIMENT RESIDENTIEL : distance au commerce sain le plus proche
   (desert alimentaire) et RFEI (marecage alimentaire) ; puis moyenne par AD.
   ========================================================================= */
function haversine(a,b){
  var R=6371000, toRad=Math.PI/180;
  var dLat=(b.lat-a.lat)*toRad, dLng=(b.lng-a.lng)*toRad;
  var lat1=a.lat*toRad, lat2=b.lat*toRad;
  var h=Math.sin(dLat/2)*Math.sin(dLat/2)+Math.cos(lat1)*Math.cos(lat2)*Math.sin(dLng/2)*Math.sin(dLng/2);
  return 2*R*Math.asin(Math.min(1,Math.sqrt(h)));
}

/* Etendue de recherche OSM : englobe tous les batiments + marge (rayon rural max) */
var searchBounds=L.latLngBounds([DATA_BUILDINGS[0][0],DATA_BUILDINGS[0][1]],[DATA_BUILDINGS[0][0],DATA_BUILDINGS[0][1]]);
DATA_BUILDINGS.forEach(function(b){ searchBounds.extend([b[0],b[1]]); });
searchBounds.extend(boundaryLayer.getBounds());
var maxPad=16000+800;
searchBounds = L.latLngBounds(
  L.latLng(searchBounds.getSouth(),searchBounds.getWest()).toBounds(maxPad*2).getSouthWest(),
  L.latLng(searchBounds.getNorth(),searchBounds.getEast()).toBounds(maxPad*2).getNorthEast()
);

var storesLayer=L.layerGroup().addTo(map);
var buildingsLayer=L.layerGroup();
var layerVisible={stores:true,buildings:false};
function toggleLayerBtn(key){
  layerVisible[key]=!layerVisible[key];
  var grp = key==='stores'?storesLayer:buildingsLayer;
  if(layerVisible[key]) map.addLayer(grp); else map.removeLayer(grp);
  document.getElementById('btn-'+key).classList.toggle('active',layerVisible[key]);
}

var osmStatus=document.getElementById('osm-status');
function setStatus(msg,isErr){osmStatus.textContent=msg;osmStatus.className=isErr?'err':'';}

function overpassFetch(query){
  return fetch('https://overpass-api.de/api/interpreter',{
    method:'POST', body:'data='+encodeURIComponent(query)
  }).then(function(r){ if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); });
}

var STORES=[]; // {latlng, cat}
var storesErr=false;

function categorize(tags){
  if(tags.amenity==='marketplace') return 'market';
  if(tags.amenity==='fast_food') return 'unhealthy';
  if(tags.shop==='convenience') return 'unhealthy';
  if(['supermarket','grocery','greengrocer'].indexOf(tags.shop)>=0) return 'healthy';
  return null;
}

function loadStores(){
  var bbox=searchBounds.getSouth()+','+searchBounds.getWest()+','+searchBounds.getNorth()+','+searchBounds.getEast();
  var q='[out:json][timeout:50];('+
    'node["shop"~"^(supermarket|convenience|grocery|greengrocer)$"]('+bbox+');'+
    'way["shop"~"^(supermarket|convenience|grocery|greengrocer)$"]('+bbox+');'+
    'node["amenity"="fast_food"]('+bbox+');way["amenity"="fast_food"]('+bbox+');'+
    'node["amenity"="marketplace"]('+bbox+');way["amenity"="marketplace"]('+bbox+');'+
    ');out center;';
  return overpassFetch(q).then(function(data){
    (data.elements||[]).forEach(function(el){
      var lat = el.type==='node'?el.lat:(el.center&&el.center.lat);
      var lon = el.type==='node'?el.lon:(el.center&&el.center.lon);
      if(lat==null||lon==null) return;
      var tags=el.tags||{};
      var cat=categorize(tags);
      if(!cat) return;
      var latlng=L.latLng(lat,lon);
      STORES.push({latlng:latlng,cat:cat,tags:tags});
      var color = cat==='healthy'?'#0482D3':(cat==='market'?'#21AEAD':'#5b54c0');
      var kind = cat==='healthy'?(tags.shop||'commerce alimentaire'):(cat==='market'?'Marché public':(tags.amenity==='fast_food'?'Restauration rapide':'Dépanneur'));
      var m=L.circleMarker(latlng,{radius:cat==='market'?7:6,color:'#ffffff88',weight:1,fillColor:color,fillOpacity:.9});
      m.on('click',function(){
        selectGeneric(tags.name||kind,'OpenStreetMap',kind,
          '<div class="src">Source : OpenStreetMap contributeurs (ODbL), via Overpass API.</div>');
      });
      m.addTo(storesLayer);
    });
  }).catch(function(e){storesErr=true; console.error('Overpass commerces:',e);});
}

/* ===== Calcul par batiment, puis agregation par AD ===== */
var BUILDING_RESULTS=[]; // parallel to DATA_BUILDINGS

function computeLive(){
  var maxLiveDist=0;
  BUILDING_RESULTS = DATA_BUILDINGS.map(function(b){
    var lat=b[0], lon=b[1], daIdx=b[2], milieuBit=b[3];
    var center=L.latLng(lat,lon);
    var milieu = milieuBit===1 ? 'Urbain' : 'Rural';
    var threshold = milieuBit===1 ? 1000 : 16000;
    var nearestHealthy=null, healthy=0, unhealthy=0;
    STORES.forEach(function(s){
      var d=haversine(center,s.latlng);
      if(s.cat==='healthy'){
        if(nearestHealthy==null||d<nearestHealthy) nearestHealthy=d;
      }
      if(s.cat==='market') return;
      if(d<=threshold){ if(s.cat==='healthy') healthy++; else unhealthy++; }
    });
    var rfei = healthy>0 ? (unhealthy/healthy) : (unhealthy>0 ? 999 : null);
    if(nearestHealthy!=null && nearestHealthy>maxLiveDist) maxLiveDist=nearestHealthy;
    return {daIdx:daIdx, milieu:milieu, threshold:threshold, dist:nearestHealthy, rfei:rfei};
  });

  var swampCount=0, desertCount=0;
  LIVE = DATA_DA.features.map(function(f){ return null; });
  DATA_DA.features.forEach(function(f,idx){
    var p=f.properties;
    if(p.n_buildings===0){ LIVE[idx]=null; return; }
    var rows = BUILDING_RESULTS.filter(function(r){ return r.daIdx===idx; });
    var dists = rows.map(function(r){return r.dist;}).filter(function(d){return d!=null;});
    var rfeis = rows.map(function(r){return r.rfei;}).filter(function(r){return r!=null;});
    var distMean = dists.length ? dists.reduce(function(a,b){return a+b;},0)/dists.length : null;
    var rfeiMean = rfeis.length ? rfeis.reduce(function(a,b){return a+b;},0)/rfeis.length : null;
    var threshold = p.milieu==='Urbain' ? 1000 : 16000;
    var overThreshold = distMean==null || distMean>threshold;
    var isDesertLive = (p.quintmat===5) && overThreshold;
    if(isDesertLive) desertCount++;
    var isSwamp = rfeiMean!=null && rfeiMean>=5;
    if(isSwamp) swampCount++;
    var statusLabel = overThreshold ?
      (p.quintmat===5 ? 'Désert alimentaire confirmé (recalculé)' : 'Distance > seuil, mais quintile matériel non Q5')
      : ('Non désert (distance ≤ '+fmt(threshold)+' m)');
    LIVE[idx]={n:dists.length, distMean:distMean, overThreshold:overThreshold, isDesertLive:isDesertLive,
      statusLabel:statusLabel, rfeiMean:rfeiMean, isSwamp:isSwamp};
  });

  if(maxLiveDist>VMAX){ VMAX=Math.ceil(maxLiveDist/1000)*1000; buildLegendScale(); }
  daLayer.eachLayer(function(l){ var idx=DATA_DA.features.indexOf(l.feature); refreshDA(l,l.feature,idx); });
  if(selected&&selected.layer&&selected.layer.feature){
    var idxSel=DATA_DA.features.indexOf(selected.layer.feature);
    selectDA(selected.layer.feature, idxSel, selected.layer);
  }

  /* Couche bâtiments (optionnelle) : petit point colore selon statut individuel */
  DATA_BUILDINGS.forEach(function(b,i){
    var r=BUILDING_RESULTS[i];
    var over = r.dist==null || r.dist>r.threshold;
    var col = over ? '#5b54c0' : '#21AEAD';
    var mkr=L.circleMarker([b[0],b[1]],{radius:3,weight:0,fillColor:col,fillOpacity:.75});
    mkr.bindTooltip((over?'Distance &gt; seuil ('+r.threshold+' m)':'Sous le seuil')+' · '+(r.dist==null?'—':fmt(r.dist))+' m · '+r.milieu,
      {className:'muni-tooltip',sticky:true});
    mkr.addTo(buildingsLayer);
  });

  return {swampCount:swampCount, desertCount:desertCount};
}

setStatus('Chargement des commerces OSM…');
loadStores().then(function(){
  if(storesErr){
    setStatus('Impossible de joindre l\'API Overpass (OSM). Distance et RFEI ne peuvent être recalculés. Vérifiez la connexion et rechargez.',true);
    return;
  }
  var r=computeLive();
  setStatus(STORES.length+' commerce(s) OSM · '+DATA_BUILDINGS.length+' bâtiments résidentiels analysés · '+r.desertCount+' AD en désert alimentaire · '+r.swampCount+' AD en marécage alimentaire.');
});

/* ===== Controles UI ===== */
var fs=1; function setFont(d){fs=Math.max(.85,Math.min(1.3,fs+d*.08));document.documentElement.style.setProperty('--fs',fs+'rem');}
function toggleMethodo(){document.getElementById('methodo-content').classList.toggle('show');}
var panelOpen=true;
function togglePanel(){panelOpen=!panelOpen;
  document.querySelector('.main').classList.toggle('collapsed',!panelOpen);
  var t=document.getElementById('panel-toggle');t.classList.toggle('shifted',!panelOpen);t.textContent=panelOpen?'◀':'▶';}
function exportGeoJSON(){
  var feats=DATA_DA.features.map(function(f,idx){
    var l=LIVE[idx]||{};
    var props=Object.assign({},f.properties,{
      dist_mean_osm:l.distMean, is_desert_live:!!(l.isDesertLive===true),
      rfei_mean:l.rfeiMean, is_swamp:!!l.isSwamp, n_buildings_used:l.n||0
    });
    return {type:'Feature',properties:props,geometry:f.geometry};
  });
  var out={type:'FeatureCollection',metadata:{titre:'Sainte-Croix — désert et marécage alimentaire (par bâtiment, recalculés en direct)',
    methode:'Robitaille & Paquette (2020), Int. J. Environ. Res. Public Health, 17(10), 3359',
    source:'CISSS des Laurentides — DSP',date:'2026-08-03'},
    features:feats.concat([DATA_BOUNDARY, DATA_PU])};
  var blob=new Blob([JSON.stringify(out)],{type:'application/json'});
  var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='sainte_croix_desert_marecage_batiments.geojson';a.click();
}
