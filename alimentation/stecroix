.muni-tooltip .tt-nom{font-weight:700;font-size:.92rem}
.muni-tooltip .tt-mrc{color:var(--muted);font-size:.74rem}
.muni-tooltip .tt-val{font-family:"JetBrains Mono";font-weight:700;font-size:1.02rem;margin-top:5px}
.leaflet-tooltip-top:before,.leaflet-tooltip-bottom:before,.leaflet-tooltip-left:before,.leaflet-tooltip-right:before{border-color:transparent!important}
#panel-toggle{position:absolute;top:14px;left:410px;z-index:700;background:var(--panel);
  border:1px solid var(--line);color:var(--ink);width:26px;height:34px;border-radius:0 8px 8px 0;
  cursor:pointer;font-size:13px;transition:left .3s ease}
